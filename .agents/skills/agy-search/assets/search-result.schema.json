{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {"type": "string"},
    "searched_at": {"type": "string"},
    "status": {"type": "string", "enum": ["answered", "partial", "insufficient"]},
    "answer": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^S[1-9][0-9]*$"},
          "url": {"type": "string", "pattern": "^https?://"},
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "published_at": {"type": "string"},
          "source_type": {"type": "string", "enum": ["primary", "secondary"]},
          "evidence_excerpt": {"type": "string"}
        },
        "required": ["id", "url", "title", "publisher", "published_at", "source_type", "evidence_excerpt"]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
          "text": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[1-9][0-9]*$"}},
          "producer_assessment": {"type": "string", "enum": ["supported", "uncertain", "contradicted"]}
        },
        "required": ["id", "text", "source_ids", "producer_assessment"]
      }
    },
    "caveats": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["query", "searched_at", "status", "answer", "sources", "claims", "caveats"]
}
